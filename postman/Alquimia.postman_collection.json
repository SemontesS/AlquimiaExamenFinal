  "item": [
    {
      "name": "01 [2.1] POST topsecret - 3 dispositivos a la vez",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/topsecret",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "topsecret"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"devices\": [\n    {\n      \"name\": \"STAR Labs\",\n      \"distance\": 851.47,\n      \"message\": [\n        \"el\",\n        \"laboratorio\",\n        \"\",\n        \"en\",\n        \"\",\n        \"muelle\"\n      ]\n    },\n    {\n      \"name\": \"CCPD\",\n      \"distance\": 291.55,\n      \"message\": [\n        \"\",\n        \"laboratorio\",\n        \"esta\",\n        \"\",\n        \"el\",\n        \"\"\n      ]\n    },\n    {\n      \"name\": \"S.T.A.R. Satellite\",\n      \"distance\": 380.79,\n      \"message\": [\n        \"el\",\n        \"\",\n        \"esta\",\n        \"en\",\n        \"\",\n        \"muelle\"\n      ]\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado esperado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Posicion (350, -250)\", function () { const j = pm.response.json(); pm.expect(j.position.x).to.eql(350); pm.expect(j.position.y).to.eql(-250); });",
              "pm.test(\"Mensaje reconstruido\", function () { pm.expect(pm.response.json().message).to.eql(\"el laboratorio esta en el muelle\"); });"
            ]
          }
        }
      ]
    },
